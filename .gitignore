# Godot 4+ specific ignores
.godot/
/android/

# The Godot AI addon keeps its own self-update cache and old plugin releases here.
# It is 7.3 MB of vendored zip files and duplicate scripts that nobody needs in
# version control, and it is regenerated by the addon itself.
addons/.godot_ai_update/

# Test-harness output. These are screenshots taken while developing, not assets the
# game loads. Delete this rule if you want them in the repo as documentation.
/verification/

# Local editor / OS noise
*.tmp
*.translation
.DS_Store
Thumbs.db

